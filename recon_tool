case "$1" in

	-nuclei)
		start_function
		nuclei_scan
		;;

	-information)
		start_function
		information
		;;

	-fuzz)
		start_function
		fuzz
		;;

	-prtscn)
		start_function
		port_scan
		;;

	-full)
		start_function
		port_scan
		nuclei_scan
		information
		fuzz
		ending_function
		;;

	*)
		usage
		;;
esac
